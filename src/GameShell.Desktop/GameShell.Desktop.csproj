<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WPF owns the entry point, so DPI awareness must be set in the manifest.
         The WinForms analyzer assumes ApplicationConfiguration.Initialize is used. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>GameShell</AssemblyName>
    <Version>0.1.0</Version>
    <RootNamespace>GameShell.Desktop</RootNamespace>
    <ApplicationIcon>Assets\GameShell.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GameShellWebRoot Condition="'$(GameShellWebRoot)' == ''">wwwroot</GameShellWebRoot>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SDL3-CS" Version="3.4.14" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameShell.Core\GameShell.Core.csproj" />
    <ProjectReference Include="..\GameShell.Windows\GameShell.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GameShell.ico" />
    <Content Include="Assets\GameShellShortcut.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(GameShellWebRoot)\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
